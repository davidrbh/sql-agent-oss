# ============================================
# 🤖 CREDENCIALES LLM (Inteligencia Artificial)
# ============================================
GOOGLE_API_KEY=your_google_ai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# ============================================
# 🗄️ BASE DE DATOS (Target para SQL Analysis)
# ============================================

DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# ============================================
# 🧠 MEMORIA DEL AGENTE (PostgreSQL Interno)
# ============================================
MEMORY_DB_USER=postgres
MEMORY_DB_PASSWORD=postgres
MEMORY_DB_NAME=agent_memory

# ============================================
# 🌐 CONEXIONES DE RED (MODO HÍBRIDO / LOCAL)
# ============================================

# 1. Dónde encuentra el Agente al Sidecar MySQL (Puerto externo Docker)
SIDECAR_URL=http://mcp-mysql:3002

# 2. Dónde encuentra el Agente a WAHA (Puerto externo Docker)
WAHA_BASE_URL=http://waha:3000

# 3. Dónde encuentra WAHA al Agente
WHATSAPP_WEBHOOK_URL=http://agent-host:8000/api/v1/webhooks/whatsapp/webhook

# 4. Registro central de micro-agentes (MCP)
# Incluye: mysql (consultas SQL), google-sheets (hojas de cálculo LibrePago), api (REST endpoints)
MCP_SERVERS_CONFIG='{"mysql":{"transport":"sse","url":"http://mcp-mysql:3002/sse"},"google-sheets":{"transport":"sse","url":"http://mcp-google-sheets:3004/sse"},"api":{"transport":"sse","url":"http://mcp-api:3003/sse"}}'

# ============================================
# 🔐 CREDENCIALES WAHA (WhatsApp)
# ============================================
WAHA_API_KEY=your_api_key_value_here
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_dashboard_password_here
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=your_swagger_password_here

# ============================================
# ⚙️ CONFIGURACIÓN AGENTE & API
# ============================================
LOG_LEVEL=INFO
DEBUG_MODE=True
# Rutas absolutas para tu entorno local
SWAGGER_JSON_PATH=/your/path/to/swagger.json
BUSINESS_CONTEXT_PATH=/your/path/to/business_context.yaml

# ============================================
# 🔌 APIs EXTERNAS
# ============================================
API_BASE_URL="https://your-api-base-url.com"
API_AUTH_HEADER="x-api-key"
API_AUTH_VALUE=your_api_key_value_here

# ============================================
# ✅ TELEGRAM
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# 📊 GOOGLE SHEETS MCP
# ============================================

# Credenciales de Google Service Account codificadas en Base64.
# Obligatorio para servidores en la nube para evitar la corrupción de saltos de línea (\n).
# Ejecuta en tu terminal: base64 -w 0 ruta/a/tu/archivo.json
# Pega la cadena resultante aquí:
GOOGLE_SHEETS_CREDENTIALS_B64='tu_cadena_base64_aqui'

# ID de la carpeta de Google Drive compartida con la Service Account.
# Se obtiene de la URL: https://drive.google.com/drive/folders/ESTE_ES_EL_ID
# Puede dejarse vacío si accedes por Spreadsheet ID directo.
GOOGLE_SHEETS_DRIVE_FOLDER_ID=your_drive_folder_id_here